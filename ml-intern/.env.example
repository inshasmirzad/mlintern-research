# Copy to .env and edit for your own machine. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ml_intern
JWT_SECRET_KEY=replace-with-a-random-64-character-value

# OmniRoute gateway. Match the port used by the OmniRoute terminal.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Start with a tool-capable connected model or combo. Change this after provider setup.
OMNIROUTE_ROUTE_MODEL=auto
# Required when OmniRoute REQUIRE_API_KEY=true. Create this key in its dashboard.
OMNIROUTE_API_KEY=replace-with-your-omniroute-gateway-key

# Optional: only needed for Hugging Face features outside the local training path.
# HF_TOKEN=
