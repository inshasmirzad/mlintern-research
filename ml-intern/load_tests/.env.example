# ========================================
# ML Intern Load Test Configuration
# ========================================

# Base URL of the application (Vite dev server proxy)
BASE_URL=http://localhost:5173

# Test scale
NUM_USERS=100
SPAWN_RATE=10

# Test user configuration
TEST_USER_PREFIX=loadtest_
TEST_USER_PASSWORD=LoadTest2026!

# Mistral rate limiting (Locust-level)
# With 3 free-tier keys at ~1 req/s each:
MISTRAL_MAX_CONCURRENT=5
MISTRAL_MAX_PER_MINUTE=15

# ML training configuration
ENABLE_ML_TRAINING=true
MAX_ML_TRAINING_RUNS=2

# Dataset/model for "report existing" scenario
CACHE_HIT_DATASET_ID=ds_3c334902
CACHE_HIT_MODEL_TYPE=RandomForestClassifier

# Dataset/model for "train new" scenario
CACHE_MISS_DATASET_ID=ds_b28e58be
CACHE_MISS_MODEL_TYPE=LogisticRegression
CACHE_MISS_TARGET_COLUMN=target

# SSE timeout (seconds)
SSE_TIMEOUT_SECONDS=300
